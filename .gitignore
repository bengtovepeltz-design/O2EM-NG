# O2EM-NG - Git ignore rules

# Visual Studio
.vs/
*.user
*.suo
*.VC.db
*.VC.VC.opendb
ipch/

# Build output
Debug/
Release/
x64/
x86/
ARM/
ARM64/
out/
build/

# Compiler and linker output
*.obj
*.o
*.pch
*.pdb
*.idb
*.ilk
*.exp
*.lib
*.iobj
*.ipdb
*.tlog
*.lastbuildstate
*.log

# Generated binaries / runtime copies
*.exe
*.dll

# Keep source-controlled config if desired
# o2em-ng.cfg is intentionally NOT ignored

# Copyrighted BIOS ROMs - never commit
BIOS/*.bin
BIOS/*.rom
BIOS/*.zip
BIOS/*.7z

# Game ROMs - never commit
ROMS/*.bin
ROMS/*.rom
ROMS/*.zip
ROMS/*.7z

# Box art content - keep the folder README, ignore artwork
BOXART/*.png
BOXART/*.jpg
BOXART/*.jpeg
BOXART/*.webp
BOXART/*.bmp

# Optional local manuals/content
MANUALS/*
!MANUALS/readme.txt
!MANUALS/README.txt
!MANUALS/README.md

# Temporary/editor files
*.tmp
*.temp
*.bak
*.old
*.orig
*~
Thumbs.db
Desktop.ini
.DS_Store

# --------------------------------------------------------------------
# Beta 3 additions
# --------------------------------------------------------------------

# SQLite database
GAMEDATA/*.db
GAMEDATA/*.db-wal
GAMEDATA/*.db-shm

# Screenshots
SCREENSHOTS/*
!SCREENSHOTS/readme.txt
!SCREENSHOTS/README.txt
!SCREENSHOTS/README.md

# Generated release packages
/dist/

# Beta 4 local data and nested firmware
BIOS/**/*.bin
BIOS/**/*.rom
*.db.backup-*
import-folders.ini
!Gamedata/o2em-ng.db

# --------------------------------------------------------------------
# Temporary development notes (project root only)
# --------------------------------------------------------------------
# Incremental patch/rollback working notes produced during development.
# These are not project documentation; permanent docs live under Docs/.
/README_Patch_*.txt
/README_Rollback_*.txt
/README_00*.txt
/PATCH_*_README.txt

# Local tool / workspace state
/.freebuff/

# Debug audio diagnostic output (see Docs/Development/Core Development Notes.md)
/sound_output_*.raw

# Python cache generated by test tooling
__pycache__/
*.pyc

# Local database backups / preservation snapshots
/Backups/

# --------------------------------------------------------------------
# Public repository scope / private development directories
# --------------------------------------------------------------------
# These directories are private or local-only. They must remain fully
# functional on the owner's machine but must never be tracked publicly.
/Installer/
/tests/
/Backups/
/Docs/Archive/
/.freebuff/
/.opencode/
/.vscode/
/.idea/
/dist/

# Local development helpers and credentials
/Docs/cf-token.txt
/wp-pass.txt
/parse_mame_3d.py

# --------------------------------------------------------------------
# Case-safe content folders and protected user media
# --------------------------------------------------------------------
# Git ignore matching is case-sensitive on non-Windows hosts. Cover both
# capitalisations used by the working tree and the release package.
BoxArt/*.png
BoxArt/*.jpg
BoxArt/*.jpeg
BoxArt/*.webp
BoxArt/*.bmp
!BoxArt/readme.txt
!BoxArt/README.txt

Manuals/*
!Manuals/readme.txt
!Manuals/README.txt
!Manuals/README.md

Screenshots/*
!Screenshots/readme.txt
!Screenshots/README.txt
!Screenshots/README.md

Roms/*.bin
Roms/*.rom
Roms/*.zip
Roms/*.7z
!Roms/Gamelist.txt
!Roms/highscore.txt

ROMS/*.bin
ROMS/*.rom
ROMS/*.zip
ROMS/*.7z
!ROMS/readme.txt
!ROMS/README.txt

BIOS/*.bin
BIOS/*.rom
BIOS/*.zip
BIOS/*.7z
BIOS/**/*.bin
BIOS/**/*.rom
BIOS/**/*.zip
BIOS/**/*.7z
!BIOS/readme.txt
!BIOS/README.txt

# --------------------------------------------------------------------
# Personal databases and SQLite transient files
# --------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
!Gamedata/o2em-ng.db

# --------------------------------------------------------------------
# Diagnostic output, crash dumps and local archives
# --------------------------------------------------------------------
*.dmp
*.mdmp
*.etl
*.trace
*.raw
*.zip
*.7z
*.rar
*.tar
*.gz
*.previous-*
*.backup-*

# --------------------------------------------------------------------
# Credentials, tokens and private keys
# --------------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.jks
*.ppk
id_rsa*
*_token.txt
*token*.txt
*secret*.txt
*credentials*.txt

